{
  "name": "fridgeboard-workspace",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "test": "vitest run && turbo run test",
    "lint": "node scripts/checkReexports/index.ts && node scripts/checkDeployments/index.ts && turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev --filter @fridgeboard/web",
    "dev:local": "pnpm --filter @fridgeboard/local dev:local",
    "dev:local:reset": "pnpm --filter @fridgeboard/local dev:local:reset",
    "prepare": "husky",
    "db:admin": "pnpm --filter @fridgeboard/local db:admin",
    "new:lambda": "new-lambda"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@fridgeboard/lambda-tooling": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "turbo": "^2.11.9",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "{apps,packages,e2e}/**/*.{ts,tsx,js,cjs,mjs}": [
      "oxfmt",
      "oxlint"
    ]
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "glob@>=9 <14.0.2": "14.0.2",
      "minimatch@>=7 <11.0.1": "11.0.1",
      "seroval@<1.6.11": "1.6.11",
      "seroval-plugins@<1.6.11": "1.6.11"
    }
  }
}
