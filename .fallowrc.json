{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "apps/web/src/main.tsx"
  ],
  "workspaces": {
    "packages": [
      "apps/*"
    ]
  },
  "ignorePatterns": [
    "dist/**",
    "**/node_modules/**"
  ],
  "duplicates": {
    "minOccurrences": 3
  },
  "rules": {
    "unused-files": "error",
    "unused-exports": "error"
  },
  "health": {
    "ignore": [
      "apps/web/index.html",
      "apps/web/src/main.tsx"
    ]
  }
}
