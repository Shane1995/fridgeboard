{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "apps/web/src/main.tsx",
    "apps/web/src/routes/**/*.tsx",
    "apps/web/scripts/thirdPartyLicenses/index.ts",
    "apps/functions/src/handlers/*/index.ts",
    "apps/functions/scripts/**/index.ts",
    "packages/contract/src/auth/constants.ts",
    "packages/contract/src/auth/types.ts",
    "packages/contract/src/me/types.ts",
    "scripts/checkReexports/index.ts"
  ],
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "ignorePatterns": [
    "dist/**",
    "**/node_modules/**",
    "apps/web/src/app/router/routeTree.gen.ts"
  ],
  "duplicates": {
    "minOccurrences": 3
  },
  "rules": {
    "unused-files": "error",
    "unused-exports": "error"
  },
  "health": {
    "ignore": [
      "apps/web/index.html",
      "apps/web/src/main.tsx"
    ]
  }
}
