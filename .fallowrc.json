{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "apps/web/src/main.tsx",
    "apps/web/src/app/router/types.ts",
    "apps/web/src/routes/**/*.tsx",
    "apps/web/src/testUtils/**/*.{ts,tsx}",
    "apps/web/scripts/thirdPartyLicenses/index.ts",
    "apps/web/src/hooks/useFeatureFlag/index.ts",
    "apps/functions/*/src/index.ts",
    "apps/functions/*/build.config.ts",
    "scripts/admin/**/index.ts",
    "packages/lambda-tooling/src/build/index.ts",
    "packages/lambda-tooling/src/smoke/index.ts",
    "packages/lambda-tooling/src/scaffold/index.ts",
    "apps/local/src/index.ts",
    "apps/local/src/reset/index.ts",
    "apps/local/src/server/index.ts",
    "apps/local/src/localConfiguration/index.ts",
    "packages/contract/src/auth/constants.ts",
    "packages/contract/src/auth/types.ts",
    "packages/contract/src/me/types.ts",
    "apps/configuration/scripts/validate/index.ts",
    "packages/lambda-kit/src/configuration/isFeatureEnabled/index.ts",
    "scripts/checkReexports/index.ts",
    "scripts/checkDeployments/index.ts",
    "e2e/api/integration/dynamodbLocal/**/*.ts"
  ],
  "workspaces": {
    "packages": ["apps/*", "apps/functions/*", "packages/*", "scripts/admin", "e2e"]
  },
  "ignorePatterns": [
    "dist/**",
    "**/node_modules/**",
    "apps/web/src/app/router/routeTree.gen.ts",
    "apps/web/public/react-aria-pressable.css"
  ],
  "duplicates": {
    "minOccurrences": 3
  },
  "rules": {
    "unused-files": "error",
    "unused-exports": "error"
  },
  "health": {
    "ignore": [
      "apps/web/index.html",
      "apps/web/src/main.tsx",
      "apps/web/src/app/router/types.ts",
      "apps/configuration/scripts/validate/index.ts",
      "apps/local/src/index.ts",
    "apps/local/src/reset/index.ts",
    "apps/local/src/server/index.ts",
    "apps/local/src/localConfiguration/index.ts",
      "apps/local/src/reset/index.ts",
      "apps/local/src/server/index.ts",
    "apps/local/src/localConfiguration/index.ts",
      "apps/local/src/constants.ts",
      "e2e/api/integration/dynamodbLocal/constants.ts",
      "e2e/api/integration/dynamodbLocal/globalSetup/index.ts",
      "e2e/api/integration/dynamodbLocal/setup/index.ts"
    ]
  },
  "ignoreUnresolvedImports": ["/react-aria-pressable.css"]
}
