                "history"
              ]
            }
          }
        },
        {
          "name": "Delete item",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/households/{{householdId}}/lists/{{listId}}/items/{{itemId}}",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "v1",
                "households",
                "{{householdId}}",
                "lists",
                "{{listId}}",
                "items",
                "{{itemId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Live sync (AppSync Events, prod only)",
      "description": "AppSync is not available on LocalStack, so these do not work against dev:local. Use them against production with the real host. Subscribing is a WebSocket (wss://<realtime host>/event/realtime, subprotocol aws-appsync-event-ws) and is not in this collection; use a Postman WebSocket request for that.",
      "item": [
        {
          "name": "Publish change",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "awsv4",
              "awsv4": [
                {
                  "key": "region",
                  "value": "eu-west-2",
                  "type": "string"
                },
                {
                  "key": "service",
                  "value": "appsync",
                  "type": "string"
                },
                {
                  "key": "accessKey",
                  "value": "{{awsAccessKeyId}}",
                  "type": "string"
                },
                {
                  "key": "secretKey",
                  "value": "{{awsSecretAccessKey}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "https://{{appsyncHttpHost}}/event",
              "protocol": "https",
              "host": ["{{appsyncHttpHost}}"],
              "path": ["event"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"/hh/{{householdId}}\",\n  \"events\": [\n    \"{\\\"type\\\":\\\"item\\\",\\\"id\\\":\\\"{{itemId}}\\\"}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "SigV4-signed publish, as the Lambdas do in publishChange. Set awsAccessKeyId and awsSecretAccessKey as collection variables with credentials allowed to publish."
          }
        }
      ]
    }
  ]
}
