{
  "version": 1,
  "featureFlags": {},
  "services": {
    "start": {
      "url": "/api/{version}/auth/start",
      "params": {
        "version": "v1"
      }
    },
    "verify": {
      "url": "/api/{version}/auth/verify",
      "params": {
        "version": "v1"
      }
    },
    "refresh": {
      "url": "/api/{version}/auth/refresh",
      "params": {
        "version": "v1"
      }
    },
    "signOut": {
      "url": "/api/{version}/auth/sign-out",
      "params": {
        "version": "v1"
      }
    },
    "me": {
      "url": "/api/{version}/me",
      "params": {
        "version": "v1"
      }
    },
    "username": {
      "url": "/api/{version}/username",
      "params": {
        "version": "v1"
      }
    }
  },
  "settings": {
    "refreshLeadMs": 60000,
    "refreshMinIntervalMs": 60000
  },
  "queries": {
    "default": {
      "staleTimeMs": 30000,
      "gcTimeMs": 300000,
      "retry": 1,
      "refetchOnWindowFocus": true
    }
  },
  "mutations": {
    "default": {
      "retry": 0
    }
  }
}
