{
  "featureFlags": {
    "ENABLE_ADMIN_INVITES": false,
    "ENABLE_PASSKEYS": true
  },
  "mutations": {
    "default": {
      "retry": 0,
      "timeoutMs": 10000
    }
  },
  "queries": {
    "default": {
      "gcTimeMs": 300000,
      "refetchOnWindowFocus": true,
      "retry": 1,
      "staleTimeMs": 30000,
      "timeoutMs": 10000
    }
  },
  "services": {
    "api": {
      "basePath": "/api/{version}",
      "endpoints": {
        "households": "/households",
        "me": "/me",
        "passkeyStart": "/auth/passkey/start",
        "passkeyVerify": "/auth/passkey/verify",
        "passkeysComplete": "/auth/passkeys/complete",
        "passkeysStart": "/auth/passkeys/start",
        "refresh": "/auth/refresh",
        "requestCode": "/auth/start",
        "signOut": "/auth/sign-out",
        "username": "/me/username",
        "verify": "/auth/verify"
      },
      "params": {
        "version": "v1"
      }
    }
  },
  "settings": {
    "refreshLeadMs": 60000,
    "refreshMinIntervalMs": 60000,
    "usernameMaxLength": 20,
    "usernameMinLength": 3
  },
  "version": 2
}
