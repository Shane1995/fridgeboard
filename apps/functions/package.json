{
  "name": "@fridgeboard/functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build/index.ts",
    "admin:invite": "node scripts/admin/invite/index.ts",
    "admin:delete-user": "node scripts/admin/deleteUser/index.ts",
    "admin:export-user": "node scripts/admin/exportUser/index.ts",
    "admin:sign-out-everywhere": "node scripts/admin/signOutEverywhere/index.ts",
    "smoke": "node scripts/smoke/index.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "oxlint --config ../../.oxlintrc.json src/ scripts/",
    "format": "oxfmt src/ scripts/",
    "format:check": "oxfmt --check src/ scripts/"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1152.0",
    "@aws-sdk/client-dynamodb": "^3.1152.0",
    "@aws-sdk/client-sesv2": "^3.1152.0",
    "@aws-sdk/client-ssm": "^3.1152.0",
    "@aws-sdk/lib-dynamodb": "^3.1152.0",
    "@fridgeboard/contract": "workspace:*",
    "@smithy/util-stream": "^4.8.2",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.5",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
